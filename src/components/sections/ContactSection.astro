---
import { site } from '../../data/site';
---

<section id="contact" class="mx-auto max-w-4xl scroll-mt-24 px-6 py-14 pb-24">
  <h2 class="font-serif text-3xl font-normal text-stone-900 dark:text-stone-100" data-reveal>
    Contact
  </h2>

  <div class="mt-8 grid gap-6 sm:grid-cols-2">
    <div class="rounded-2xl border border-stone-200 bg-white p-8 dark:border-stone-800 dark:bg-stone-900/40" data-reveal>
      <h3 class="font-serif text-lg font-medium text-stone-900 dark:text-stone-100">Reach me</h3>

      <dl class="mt-5 space-y-4 text-sm">
        <div>
          <dt class="text-stone-500 dark:text-stone-500">Email</dt>
          <dd class="mt-0.5">
            <a href={`mailto:${site.email}`} class="font-medium text-accent-700 hover:underline dark:text-accent-400">
              {site.email}
            </a>
          </dd>
        </div>

        <div>
          <dt class="text-stone-500 dark:text-stone-500">Phone</dt>
          <dd class="mt-0.5">
            <details class="group">
              <summary class="inline-flex cursor-pointer list-none items-center gap-1 font-medium text-accent-700 hover:underline dark:text-accent-400">
                Show phone number
              </summary>
              <p class="mt-1 font-medium text-stone-700 dark:text-stone-300">{site.phone}</p>
            </details>
          </dd>
        </div>
      </dl>

      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={site.scholar}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 transition hover:border-accent-400 hover:text-accent-700 dark:border-stone-700 dark:text-stone-300 dark:hover:border-accent-600 dark:hover:text-accent-400"
        >
          Google Scholar
        </a>
        <a
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-full border border-stone-300 px-4 py-2 text-sm font-medium text-stone-700 transition hover:border-accent-400 hover:text-accent-700 dark:border-stone-700 dark:text-stone-300 dark:hover:border-accent-600 dark:hover:text-accent-400"
        >
          GitHub
        </a>
      </div>
    </div>

    <div class="flex flex-col justify-between rounded-2xl border border-stone-200 bg-white p-8 dark:border-stone-800 dark:bg-stone-900/40" data-reveal>
      <div>
        <h3 class="font-serif text-lg font-medium text-stone-900 dark:text-stone-100">Curriculum Vitae</h3>
        <p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-400">
          Full CV with publications, experience, and awards.
        </p>
      </div>
      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a
          href={site.resumeUrl}
          download
          class="inline-flex w-fit items-center gap-2 rounded-full bg-accent-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-accent-700"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-4">
            <path d="M12 4v12m0 0-4-4m4 4 4-4M4 20h16" />
          </svg>
          Download Resume (PDF)
        </a>
        <a
          href={site.resumeDriveUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-fit items-center gap-1.5 rounded-full border border-stone-300 px-4 py-2.5 text-sm font-medium text-stone-700 transition hover:border-accent-400 hover:text-accent-700 dark:border-stone-700 dark:text-stone-300 dark:hover:border-accent-600 dark:hover:text-accent-400"
        >
          View on Google Drive
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-3">
            <path d="M7 17 17 7M8 7h9v9" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
