---
import { Image } from 'astro:assets';
import StatusBadge from './StatusBadge.astro';

// Eagerly glob every paper figure so a frontmatter filename can resolve to an
// optimised image without a per-paper import.
const figures = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/papers/*.{jpeg,jpg,png,webp,avif}',
  { eager: true }
);

interface Props {
  title: string;
  status: 'under-review' | 'manuscript-ready' | 'accepted' | 'published' | 'in-progress';
  venue?: string;
  date?: string;
  tag?: string;
  preprint?: string;
  authors?: string[];
  advisor?: string;
  summary: string;
  link?: string;
  figure?: string;
  figureCaption?: string;
  figureCaptionInImage?: boolean;
  resultsCaption?: string;
  resultsColumns?: string[];
  resultsRows?: string[][];
}

const {
  title, status, venue, date, tag, preprint, authors, advisor, summary, link,
  figure, figureCaption, figureCaptionInImage, resultsCaption, resultsColumns, resultsRows,
} = Astro.props;

const figureImage = figure ? figures[`/src/assets/papers/${figure}`]?.default : undefined;
const hasResults = !!(resultsColumns?.length && resultsRows?.length);
---

<article class="grid gap-3 border-t border-stone-200 py-6 sm:grid-cols-[7rem_1fr] sm:gap-6 dark:border-stone-800">
  <div class="sm:pt-1">
    {tag && (
      <span class="inline-flex items-center rounded border border-stone-200 px-2 py-1 font-mono text-[0.7rem] tracking-tight text-stone-500 dark:border-stone-800 dark:text-stone-500">
        {tag}
      </span>
    )}
  </div>

  <div>
    <h3 class="font-serif text-lg leading-snug font-medium text-stone-900 dark:text-stone-100">
      {link ? (
        <a href={link} target="_blank" rel="noopener noreferrer" class="hover:text-accent-700 hover:underline dark:hover:text-accent-400">
          {title}
        </a>
      ) : (
        title
      )}
    </h3>

    {authors && authors.length > 0 && (
      <p class="mt-1.5 text-sm text-stone-600 dark:text-stone-400">
        {authors.map((author, i) => (
          <>
            {i > 0 && ', '}
            {author.includes('Chatwal') ? (
              <span class="font-semibold text-stone-800 dark:text-stone-200">{author}</span>
            ) : (
              author
            )}
          </>
        ))}
      </p>
    )}

    {(venue || date) && (
      <p class="mt-1.5 text-sm text-stone-500 italic dark:text-stone-500">
        {/* A venue that already reads as a sentence ("Targeting …") shouldn't get an "In" prefix. */}
        {venue?.startsWith('Targeting') ? '' : 'In '}{venue}{venue && date && ', '}{date}
      </p>
    )}

    {preprint && (
      <p class="mt-1 text-sm text-stone-500 dark:text-stone-500">Preprint: {preprint}</p>
    )}

    {advisor && (
      <p class="mt-1.5 text-sm text-stone-500 italic dark:text-stone-500">Advised by {advisor}</p>
    )}

    <div class="mt-2.5">
      <StatusBadge status={status} />
    </div>

    <p class="mt-3 text-[0.925rem] leading-relaxed text-stone-600 dark:text-stone-400">{summary}</p>

    {figureImage && (
      <figure class="mt-4">
        <Image
          src={figureImage}
          alt={figureCaption ?? `Figure from ${title}`}
          class="w-full max-w-xl rounded-lg border border-stone-200 bg-white dark:border-stone-800"
          widths={[440, 880]}
          sizes="(min-width: 768px) 576px, 100vw"
        />
        {figureCaption && !figureCaptionInImage && (
          <figcaption class="mt-2 max-w-xl text-xs leading-relaxed text-stone-500 dark:text-stone-500">
            {figureCaption}
          </figcaption>
        )}
      </figure>
    )}

    {hasResults && (
      <figure class="mt-4 max-w-xl">
        <div class="overflow-x-auto rounded-lg border border-stone-200 dark:border-stone-800">
          <table class="w-full border-collapse text-left text-xs">
            <thead>
              <tr class="border-b border-stone-200 dark:border-stone-800">
                {resultsColumns!.map((col, i) => (
                  <th
                    class:list={[
                      'px-2.5 py-2 font-semibold text-stone-700 dark:text-stone-300',
                      i > 0 && 'text-right tabular-nums',
                    ]}
                  >
                    {col}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {resultsRows!.map((row) => (
                <tr class="border-b border-stone-100 last:border-0 dark:border-stone-900">
                  {row.map((cell, i) => (
                    <td
                      class:list={[
                        'px-2.5 py-1.5 text-stone-600 dark:text-stone-400',
                        i === 0 ? 'whitespace-nowrap' : 'text-right font-mono tabular-nums',
                      ]}
                    >
                      {cell}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {resultsCaption && (
          <figcaption class="mt-2 font-mono text-xs leading-relaxed text-stone-500 dark:text-stone-500">
            {resultsCaption}
          </figcaption>
        )}
      </figure>
    )}
  </div>
</article>
